  "reconstruction_detach": true,
  "output_dir": "outputs/phase_execution_smoke/economics_cmdl",
  "experiment_name": "phase_economics_cmdl_smoke",
  "device": "cpu",
  "disable_mlflow": true,
  "log_every": 10,
